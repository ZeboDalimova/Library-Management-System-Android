<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingTop="30dp"
    android:padding="20dp"
    android:orientation="vertical"
    tools:context=".FragmentUpdateCategory">

    <EditText
        android:id="@+id/editTextNameCategoryUpdate"
        android:layout_width="match_parent"
        android:background="@drawable/edit_text"
        android:paddingLeft="10dp"
        android:textColor="@color/black"
        android:layout_marginTop="50dp"
        android:layout_height="50dp"
        android:hint="Название категории"/>


    <Button
        android:id="@+id/btnSelectImageCatUpdate"
        android:layout_width="250dp"
        android:layout_gravity="top|center"
        android:layout_height="50dp"
        android:layout_marginTop="50dp"
        android:text="Select Image from Gallery" />

    <ImageView
        android:id="@+id/imageViewCategorySaveUpdate"
        android:layout_width="match_parent"
        android:layout_height="250dp"
        android:layout_marginTop="50dp"
        android:layout_marginBottom="20dp"
        android:layout_gravity="top|center"
        android:scaleType="centerCrop" />

    <Button
        android:id="@+id/btnSaveCategoryUpdate"
        android:layout_width="250dp"
        android:layout_gravity="bottom|center"
        android:layout_height="50dp"
        android:layout_marginBottom="70dp"
        android:text="Update Category" />

</LinearLayout>