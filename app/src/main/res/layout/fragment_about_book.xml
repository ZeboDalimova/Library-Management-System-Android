<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".FragmentAboutBook"
    android:background="@color/white"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        >
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/oblojka_book_about"
                android:layout_width="210dp"
                android:layout_height="300dp"
                android:layout_gravity="center"
                android:layout_marginTop="40dp"
                android:src="@drawable/oblojka_knigi"/>
            <TextView
                android:id="@+id/name_book_about"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="25dp"
                android:textColor="@color/black"
                android:textSize="24dp"
                android:gravity="center"
                android:fontFamily="sans-serif-condensed-medium"
                android:text="AAAAA BBBBBB CCCCCCC DDDDDDD"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20dp"
                android:layout_marginRight="20dp"
                android:layout_marginBottom="5dp"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="100dp"
                    android:layout_height="wrap_content"
                    android:textColor="@color/black"
                    android:textSize="21dp"
                    android:fontFamily="sans-serif-condensed-medium"
                    android:text="Автор:"/>
                <TextView
                    android:id="@+id/avtor_book_about"
                    android:layout_width="match_parent"
                    android:textColor="#636363"
                    android:layout_height="wrap_content"
                    android:textSize="21dp"
                    android:fontFamily="sans-serif-condensed-medium"
                    android:text="ААААААА"/>
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20dp"
                android:layout_marginRight="20dp"
                android:layout_marginBottom="10dp"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="100dp"
                    android:layout_height="wrap_content"
                    android:textColor="@color/black"
                    android:textSize="21dp"
                    android:fontFamily="sans-serif-condensed-medium"
                    android:text="Категория:"/>
                <TextView
                    android:id="@+id/kategoriya_book_about"
                    android:layout_width="match_parent"
                    android:textColor="#636363"
                    android:layout_height="wrap_content"
                    android:textSize="21dp"
                    android:fontFamily="sans-serif-condensed-medium"
                    android:text="Кулинария"/>
            </LinearLayout>
            <LinearLayout
                android:id="@+id/aaaaasss"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/dobavitVIzbr"
                    android:padding="0dp"
                    android:layout_width="110dp"
                    android:background="@drawable/edit_text"
                    android:layout_marginRight="8dp"
                    android:layout_height="50dp"
                    android:text="Добавить "/>
                <Button
                    android:id="@+id/chitat"
                    android:padding="0dp"
                    android:background="@drawable/edit_text"
                    android:layout_width="110dp"
                    android:layout_marginRight="8dp"
                    android:layout_height="50dp"
                    android:text="Читать "/>
                <Button
                    android:id="@+id/audioAboutBook"
                    android:padding="0dp"
                    android:background="@drawable/edit_text"
                    android:layout_width="110dp"
                    android:layout_height="50dp"
                    android:text="Аудио "/>

            </LinearLayout>

            <TextView
                android:layout_marginRight="20dp"
                android:textColor="@color/black"
                android:layout_marginLeft="20dp"
                android:layout_marginTop="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="20dp"
                android:fontFamily="sans-serif-condensed-medium"
                android:text="Описания"/>

            <TextView
                android:id="@+id/opisaniya_book_about"
                android:textColor="#636363"
                android:layout_marginRight="20dp"
                android:layout_marginLeft="20dp"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="20dp"
                android:fontFamily="sans-serif-condensed"
                android:text="aaaaaaaaaa ccccccccccc dddddddddd ssssssssss wwwwwwww eeeeeeeeeeee rrrrrrrrrrrrr wwwwwwwwwwwwww ssssssssssssss sssss"/>

        </LinearLayout>


    </ScrollView>
</LinearLayout>