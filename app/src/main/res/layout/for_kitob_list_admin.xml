<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:padding="8dp"
    android:gravity="center"
    android:layout_width="match_parent"
    android:layout_height="120dp">

    <ImageView
        android:id="@+id/k_a_rasm"
        android:layout_width="90dp"
        android:layout_height="100dp"
        android:layout_weight="0"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="5dp"
        android:layout_weight="0.9"
        android:orientation="vertical">
        <TextView
            android:id="@+id/k_a_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/black"
            android:text="kitab nomi"
            android:textSize="18dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView
                android:layout_marginTop="10dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="5dp"
                android:textSize="16dp"
                android:textColor="@color/black"
                android:text="Автор: " />
            <TextView
                android:id="@+id/k_a_avtor"
                android:layout_marginTop="10dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="16dp"
                android:textColor="@color/black"
                android:text="avtor" />
        </LinearLayout>

        <TextView
            android:id="@+id/k_a_kat"
            android:layout_marginTop="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/black"
            android:text="kategoriyasi" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:orientation="vertical"
        android:layout_gravity="center"
        android:paddingTop="5dp"
        android:paddingBottom="5dp"
        android:gravity="center"
        android:layout_weight="2.2">

        <Button
            android:id="@+id/spisok_knig_admin_update"
            android:layout_width="25dp"
            android:layout_marginBottom="20dp"
            android:layout_height="25dp"
            android:background="@drawable/baseline_border_color_24"
            android:layout_weight="1"/>
        <Button
            android:id="@+id/spisok_knig_admin_delete"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:background="@drawable/baseline_delete_24"
            android:layout_weight="1"/>


    </LinearLayout>

</LinearLayout>