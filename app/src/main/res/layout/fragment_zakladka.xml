<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".Fragment_Zakladka">


    <LinearLayout
        android:layout_width="match_parent"
        android:orientation="horizontal"
        android:layout_marginTop="20dp"
        android:gravity="center"
        android:layout_height="50dp">

        <Button
            android:id="@+id/btnChitatt"
            android:layout_width="110dp"
            android:layout_marginRight="6dp"
            android:textSize="14dp"
            android:padding="0dp"
            android:layout_height="match_parent"
            android:background="@drawable/edit_text"
            android:text="Читаю"/>
        <Button
            android:id="@+id/btnPrachitana"
            android:layout_width="110dp"
            android:textSize="14dp"
            android:padding="0dp"
            android:layout_marginRight="6dp"
            android:layout_height="match_parent"
            android:background="@drawable/edit_text"
            android:text="Прочитано"/>
        <Button
            android:id="@+id/btnBuduchitat"
            android:layout_width="110dp"
            android:textSize="14dp"
            android:padding="0dp"
            android:layout_height="match_parent"
            android:background="@drawable/edit_text"
            android:text="В планах"/>
    </LinearLayout>

    <TextView
        android:id="@+id/statusknigtxt"
        android:layout_width="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="20dp"
        android:textSize="16dp"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:textColor="@color/grey"
        android:text="Все"/>

    <ListView
        android:id="@+id/listBooksZakladka"
        android:layout_marginRight="15dp"
        android:layout_marginLeft="15dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:dividerHeight="10dp"
        android:background="@color/white"
        android:divider="@android:color/white"
        android:layout_marginTop="20dp"/>

</LinearLayout>