<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:padding="8dp"
    android:gravity="center"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="250dp"
        android:layout_margin="7dp"
        app:layout_constraintLeft_toRightOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/kategoriya_image_for_listAdmin"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/istoriya_janr_knig"
            android:scaleType="centerCrop"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:gravity="center"
            android:alpha="0.55"
            android:background="@color/grey"
            android:layout_gravity="center|bottom">
        </LinearLayout>
        <TextView
            android:id="@+id/kategoriya_nomi_for_listAdmin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/white"
            android:gravity="center"
            android:layout_gravity="center|bottom"
            android:text="Kategoriya nomi"
            android:paddingBottom="15dp"
            android:fontFamily="sans-serif-medium"
            android:textSize="25dp"/>


        <LinearLayout
            android:layout_width="70dp"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:layout_gravity="center|right"
            android:background="#C98ABFBF"
            android:layout_marginBottom="44dp"
            android:paddingTop="25dp"
            android:paddingBottom="25dp"
            android:gravity="center"
            android:layout_weight="2.2">

            <Button
                android:id="@+id/spisok_category_admin_updateAdmin"
                android:layout_width="40dp"
                android:layout_marginBottom="30dp"
                android:layout_height="40dp"
                android:background="@drawable/baseline_border_color_24"
                android:layout_weight="1"/>
            <Button
                android:id="@+id/spisok_category_admin_deleteAdmin"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/baseline_delete_24"
                android:layout_weight="1"/>


        </LinearLayout>
    </androidx.cardview.widget.CardView>


</LinearLayout>