<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".FragmentAddBook">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="20dp"
            android:orientation="vertical">
            <EditText
                android:id="@+id/editTextBookname"
                android:layout_width="match_parent"
                android:background="@drawable/edit_text"
                android:textColor="@color/black"
                android:textColorHint="@color/grey"
                android:paddingLeft="15dp"
                android:layout_marginTop="30dp"
                android:layout_height="50dp"
                android:inputType="text"
                android:hint="Название книги"/>
            <EditText
                android:id="@+id/editTextBookavtor"
                android:layout_width="match_parent"
                android:background="@drawable/edit_text"
                android:textColor="@color/black"
                android:textColorHint="@color/grey"
                android:paddingLeft="15dp"
                android:layout_marginTop="30dp"
                android:layout_height="50dp"
                android:inputType="text"
                android:hint="Автор книги"/>

            <RadioGroup
                android:id="@+id/RadioGroupBookKateg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:padding="15dp"
                android:background="@drawable/edit_text">

                <EditText
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Выберите категорию:"
                    android:textColorLink="@color/fon3"
                    android:theme="@style/Base.Theme.Kutubxona"
                    android:textColor="@color/black"/>


            </RadioGroup>

            <Button
                android:id="@+id/btnSelectFile"
                android:layout_width="250dp"
                android:layout_height="60dp"
                android:background="@drawable/edit_text"
                android:layout_gravity="center"
                android:layout_marginTop="30dp"
                android:text="Select File from Files" />
            <TextView
                android:id="@+id/textViewSelectFile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/black"
                android:textSize="16dp"
                android:layout_marginTop="15dp"
                android:gravity="center"
                android:text="exemple.pdf"/>

            <EditText
                android:id="@+id/editTextOpisaniya"
                android:layout_width="match_parent"
                android:background="@drawable/edit_text"
                android:textColor="@color/black"
                android:textColorHint="@color/grey"
                android:gravity="start"
                android:padding="10dp"
                android:paddingLeft="15dp"
                android:layout_marginTop="30dp"
                android:layout_height="wrap_content"
                android:hint="Описание книги"/>
            <Button
                android:id="@+id/btnSelectAudio"
                android:layout_width="250dp"
                android:layout_height="60dp"
                android:background="@drawable/edit_text"
                android:layout_gravity="center"
                android:layout_marginTop="30dp"
                android:text="Select Audio from Files" />
            <TextView
                android:id="@+id/textViewSelectAudio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/black"
                android:textSize="16dp"
                android:layout_marginTop="15dp"
                android:gravity="center"
                android:text="exemple.mp3"/>

            <Button
                android:id="@+id/btnSelectImage"
                android:layout_width="250dp"
                android:layout_height="60dp"
                android:background="@drawable/edit_text"
                android:layout_gravity="center"
                android:layout_marginTop="30dp"
                android:text="Select Image from Gallery" />

            <ImageView
                android:id="@+id/imageViewBookSave"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:layout_gravity="center"
                android:background="@drawable/edit_text"
                android:scaleType="centerCrop" />

            <Button
                android:id="@+id/btnSaveBook"
                android:layout_width="250dp"
                android:layout_height="60dp"
                android:background="@drawable/edit_text"
                android:layout_gravity="center"
                android:layout_marginTop="30dp"
                android:text="Add" />

        </LinearLayout>
    </ScrollView>

</FrameLayout>