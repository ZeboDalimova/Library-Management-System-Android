<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/fon_color"
    tools:context=".Activityregister">

    <ImageView
        android:layout_width="91dp"
        android:layout_height="96dp"
        android:background="@drawable/logotip"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.025" />

    <LinearLayout
        android:layout_width="352dp"
        android:layout_height="530dp"
        android:background="@drawable/login_yozuv_fon"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.832">



        <EditText
            android:id="@+id/RegUserName"
            style="@style/editTextStyle"
            android:layout_marginTop="20dp"
            android:background="@drawable/edit_text"
            android:drawableLeft="@drawable/person2"
            android:hint="Username"
            android:layout_weight="1"/>


        <EditText
            android:id="@+id/RegEmail"
            style="@style/editTextStyle"
            android:layout_marginTop="20dp"
            android:background="@drawable/edit_text"
            android:drawableLeft="@drawable/email"
            android:hint="Email"
            android:layout_weight="1"/>
        <EditText
            android:id="@+id/RegPhone"
            style="@style/editTextStyle"
            android:layout_marginTop="20dp"
            android:background="@drawable/edit_text"
            android:drawableLeft="@drawable/baseline_phone_24"
            android:hint="Phone"
            android:layout_weight="1"/>

        <EditText
            android:id="@+id/RegPassword"
            style="@style/editTextStyle"
            android:layout_marginTop="20dp"
            android:background="@drawable/edit_text"
            android:inputType="textPassword"
            android:drawableLeft="@drawable/password"
            android:hint="Password"
            android:layout_weight="1"/>

        <Button
            android:id="@+id/register"
            android:layout_width="200dp"
            android:layout_height="60dp"
            android:layout_gravity="center"
            android:layout_marginTop="20dp"
            android:background="@drawable/edit_text"
            android:onClick="onClick"
            android:text="REGISTER"
            android:textSize="20dp"
            android:layout_weight="1"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:layout_weight="1">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Have Account?"
                android:textSize="17dp" />

            <TextView
                android:id="@+id/LoginToRegister"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginLeft="20dp"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:onClick="onClickRegister"
                android:text="Login"
                android:textColor="@color/fon2"
                android:textSize="20dp" />
        </LinearLayout>

    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="REGISTER"
        android:textColor="@color/white"
        android:textSize="30dp"
        app:fontFamily="sans-serif-black"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.175"
        app:textAllCaps="true" />
</androidx.constraintlayout.widget.ConstraintLayout>